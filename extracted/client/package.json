{
  "name": "@nxt/fetch-client",
  "version": "1.0.0",
  "license": "MIT",
  "description": "A generic typed fetch client with SSE streaming support — extracted from the Medusa JS SDK.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch"
  },
  "dependencies": {
    "fetch-event-stream": "^0.1.5",
    "qs": "^6.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/qs": "^6.15.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "fetch",
    "http-client",
    "sse",
    "typed-fetch",
    "streaming"
  ],
  "sideEffects": false
}
